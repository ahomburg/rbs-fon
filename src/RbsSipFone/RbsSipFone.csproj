<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>rbs-sip-fone</AssemblyName>
    <RootNamespace>RbsSipFone</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>ringring best sipfon (rbs)</Product>
    <AssemblyTitle>ringring best sipfon (rbs)</AssemblyTitle>
    <Company>rbs Redaktionsbüro Stutensee</Company>
    <Description>ringring best sipfon (rbs) – einfaches SIP-Telefon mit mehreren Konten</Description>
    <Version>1.0.0</Version>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SIPSorceryMedia.Windows" Version="10.0.17" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\rbs-logo.png" />
    <Resource Include="Assets\rbs-symbol.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

</Project>
