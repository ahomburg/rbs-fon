<Window x:Class="RbsSipFone.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" Width="640" Height="640" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <DockPanel>
        <Rectangle DockPanel.Dock="Top" Height="4" Fill="{StaticResource Orange}" />
        <StackPanel DockPanel.Dock="Top" Margin="28,18,28,6">
            <TextBlock Text="Einstellungen" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" FontSize="12" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="28,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" MinWidth="100" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Speichern" IsDefault="True" MinWidth="110" Margin="10,0,0,0" Click="Save_Click" />
                </StackPanel>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs">
            <!-- Audio -->
            <TabItem Header="Audio">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,22">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Mikrofon" />
                        <ComboBox x:Name="MicBox" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lautsprecher / Headset" />
                        <ComboBox x:Name="SpeakerBox" />
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Klingelton auf" />
                        <ComboBox x:Name="RingBox" />
                        <TextBlock Style="{StaticResource Hint}" Text="Änderungen gelten ab dem nächsten Gespräch." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Verhalten -->
            <TabItem Header="Verhalten">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,22">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="GESPRÄCHE" Margin="0,14,0,0" HorizontalAlignment="Left" />
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,6,0,0" />
                        <CheckBox x:Name="AutoHoldBox" Content="Andere Gespräche automatisch halten, wenn ein Gespräch beginnt" Margin="0,12,0,0" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="PROGRAMMSTART" Margin="0,22,0,0" HorizontalAlignment="Left" />
                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,6,0,0" />
                        <CheckBox x:Name="AutostartBox" Content="Automatisch beim Windows-Start starten" Margin="0,12,0,0" />
                        <CheckBox x:Name="AutostartMinimizedBox" Content="Dabei minimiert starten" Margin="26,8,0,0"
                                  IsEnabled="{Binding IsChecked, ElementName=AutostartBox}" />
                        <TextBlock x:Name="AutostartHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Telefon-Links -->
            <TabItem Header="Telefon-Links">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,22">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                                   Text="Links wie tel:, callto: und sip: auf Webseiten, in Outlook oder Teams mit diesem Programm öffnen." />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Ellipse x:Name="LinkDot" Width="8" Height="8" VerticalAlignment="Center" />
                            <TextBlock x:Name="LinkStatus" FontSize="12.5" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="LinkHint" Style="{StaticResource Hint}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button x:Name="RegisterButton" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0" Click="Register_Click" />
                            <Button x:Name="DefaultAppsButton" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="DefaultApps_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Margin="0,0,8,0" />
                                    <TextBlock Text="Windows-Standard-Apps öffnen" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <CheckBox x:Name="DialLinksBox" Content="Bei Klick auf einen Link sofort wählen (sonst nur ins Wählfeld übernehmen)" Margin="0,16,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Anrufer-Erkennung -->
            <TabItem Header="Anrufer-Erkennung">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,22">
                        <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0">
                            Bei einem eingehenden Anruf wird ein REST-Dienst (HTTP GET) mit der Rufnummer aufgerufen, z. B. Ihr CRM
                            oder Telefonbuch. Liefert er einen Namen, wird dieser statt der Nummer angezeigt und in der Anrufliste gespeichert.
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Service-URL" />
                        <TextBox x:Name="LookupUrlBox" />
                        <TextBlock Style="{StaticResource Hint}">
                            <Run Text="{}{number}" FontWeight="SemiBold" /> wird durch die Rufnummer ersetzt, z. B.
                            <Run Text="https://crm.example.de/api/caller?phone={number}" FontFamily="Consolas" />.
                            Ohne Platzhalter wird <Run Text="?number=…" FontFamily="Consolas" /> angehängt. Leer lassen = aus.
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="API-Key (optional)" />
                        <PasswordBox x:Name="LookupKeyBox" />
                        <TextBlock Style="{StaticResource Hint}">
                            Wird im Header <Run Text="X-API-Key" FontFamily="Consolas" /> mitgeschickt oder über
                            <Run Text="{}{apikey}" FontWeight="SemiBold" /> in die URL eingesetzt. Er wird verschlüsselt gespeichert.
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Erwartete Antwort" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0">
                            Der Name als Text (<Run Text="Max Mustermann" FontFamily="Consolas" />) oder als JSON, z. B.
                            <Run Text="{}{&quot;name&quot;: &quot;Max Mustermann&quot;}" FontFamily="Consolas" />.
                            HTTP 404 oder eine leere Antwort bedeutet „unbekannt“. Der Dienst muss innerhalb von 4 Sekunden antworten.
                        </TextBlock>

                        <TextBlock Style="{StaticResource FieldLabel}" Text="Dienst testen" Margin="0,16,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="LookupTestButton" Style="{StaticResource SecondaryButton}" Padding="14,6"
                                    Margin="8,0,0,0" Content="Testen" Click="LookupTest_Click" />
                            <TextBox x:Name="LookupTestNumberBox" Text="+49721123456" />
                        </DockPanel>
                        <TextBlock x:Name="LookupTestResult" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Netzwerk & Diagnose -->
            <TabItem Header="Netzwerk &amp; Diagnose">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28,8,28,22">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Lokaler SIP-Port" />
                        <TextBox x:Name="PortBox" Width="120" HorizontalAlignment="Left" />
                        <TextBlock Style="{StaticResource Hint}" Text="Standard 5060, 0 = automatisch. Ist der Port belegt, wird automatisch ein freier gewählt. Wirksam nach Neustart." />
                        <CheckBox x:Name="TraceBox" Content="SIP-Nachrichten protokollieren (zur Fehlersuche)" Margin="0,16,0,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Protokollordner öffnen" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Padding="12,6" Click="OpenLog_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
