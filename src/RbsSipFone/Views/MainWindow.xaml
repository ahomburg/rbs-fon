<Window x:Class="RbsSipFone.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:RbsSipFone.ViewModels"
        xmlns:models="clr-namespace:RbsSipFone.Models"
        Title="ringring best sipfon (rbs)" Icon="/Assets/app.ico"
        Width="1140" Height="740" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Page}" FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource Ink}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleViewCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Kontokarte -->
        <DataTemplate x:Key="AccountCard" DataType="{x:Type vm:AccountViewModel}">
            <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="3" Margin="0,0,0,8" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{Binding State, Converter={StaticResource RegBrush}}" />
                    <Grid Grid.Column="1" Margin="12,10,8,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Enabled}"
                                  ToolTip="Konto aktivieren / deaktivieren" Margin="0,1,4,0" />

                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding Address}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                            <TextBlock Text="{Binding TransportLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                       Margin="6,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>

                        <DockPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Konto bearbeiten" AutomationProperties.Name="Konto bearbeiten"
                                        Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Konto entfernen" AutomationProperties.Name="Konto entfernen"
                                        Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                            <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource RegBrush}}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource Muted}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Gesprächskarte -->
        <DataTemplate x:Key="CallCard" DataType="{x:Type vm:CallViewModel}">
            <Border x:Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    CornerRadius="4" Padding="16,14" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="IconBg" Width="42" Height="42" CornerRadius="21" Background="{StaticResource OrangeSoft}" VerticalAlignment="Top">
                            <TextBlock x:Name="IconGlyph" Style="{StaticResource Icon}" Text="{Binding DirectionGlyph}" FontSize="16" Foreground="{StaticResource Orange}" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,8,0">
                            <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Muted}"
                                       Visibility="{Binding Subtitle, Converter={StaticResource EmptyToCollapsed}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Border Style="{StaticResource Badge}">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Account.Name}" />
                                </Border>
                                <TextBlock x:Name="StateLabel" Text="{Binding StateText}" FontSize="12" Foreground="{StaticResource Muted}"
                                           Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="18" FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Top"
                                   Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- Aktionen: eingehender Anruf -->
                    <!-- WrapPanel: in der schmalen Mini-Ansicht rutscht „Ablehnen“ in die nächste Zeile -->
                    <WrapPanel Margin="56,14,0,-6"
                                Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource SuccessButton}" Padding="18,8" Margin="0,0,8,6" AutomationProperties.Name="Annehmen"
                                Command="{Binding DataContext.AnswerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" Margin="0,0,8,0" />
                                <TextBlock Text="Annehmen" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" Padding="18,8" Margin="0,0,0,6" AutomationProperties.Name="Ablehnen"
                                Command="{Binding DataContext.RejectCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" Margin="0,0,8,0" />
                                <TextBlock Text="Ablehnen" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Aktionen: ausgehender Anruf im Aufbau -->
                    <StackPanel Orientation="Horizontal" Margin="56,14,0,0"
                                Visibility="{Binding IsOutgoingPending, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource DangerButton}" Padding="18,8" AutomationProperties.Name="Abbrechen"
                                Command="{Binding DataContext.HangupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" Margin="0,0,8,0" />
                                <TextBlock Text="Abbrechen" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Aktionen: verbunden -->
                    <WrapPanel Margin="56,14,0,0" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource CallAction}" Tag="{Binding IsOnHold}" AutomationProperties.Name="Halten" Margin="0,0,6,6"
                                Command="{Binding DataContext.HoldCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE769;" FontSize="15" />
                                <TextBlock Text="Halten" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CallAction}" Tag="{Binding IsMuted}" AutomationProperties.Name="Stumm" Margin="0,0,6,6"
                                Command="{Binding DataContext.MuteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE720;" FontSize="15" />
                                <TextBlock Text="Stumm" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource CallAction}" Margin="0,0,6,6" AutomationProperties.Name="Weiterleiten"
                                Command="{Binding DataContext.TransferCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72A;" FontSize="15" />
                                <TextBlock Text="Weiterleiten" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource DangerButton}" AutomationProperties.Name="Auflegen" Padding="10,6" MinWidth="74" Margin="0,0,6,6" FontWeight="Normal" FontSize="11.5"
                                Command="{Binding DataContext.HangupCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE778;" FontSize="15" />
                                <TextBlock Text="Auflegen" Margin="0,3,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Ink}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Orange}" />
                    <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    <Setter TargetName="IconBg" Property="Background" Value="{StaticResource Orange}" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="White" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xE717;" />
                    <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource Orange}" />
                    <Setter TargetName="StateLabel" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOnHold}" Value="True">
                    <Setter TargetName="IconBg" Property="Background" Value="{StaticResource Panel}" />
                    <Setter TargetName="IconGlyph" Property="Foreground" Value="{StaticResource Muted}" />
                    <Setter TargetName="IconGlyph" Property="Text" Value="&#xE769;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEnded}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Line}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Eintrag der Anrufliste -->
        <DataTemplate x:Key="HistoryRow" DataType="{x:Type models:CallHistoryEntry}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Zurückrufen" Command="{Binding PlacementTarget.Tag.CallHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="In Wählfeld übernehmen" Command="{Binding PlacementTarget.Tag.PickHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                        <MenuItem Header="Nummer kopieren" Click="CopyNumber_Click" />
                        <Separator />
                        <MenuItem Header="Eintrag löschen" Command="{Binding PlacementTarget.Tag.DeleteHistoryCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}" />
                    </ContextMenu>
                </Grid.ContextMenu>
                <Grid.Tag>
                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}" />
                </Grid.Tag>
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13"
                           Foreground="{StaticResource Cyan}" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="TitleText" Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE717;" ToolTip="Zurückrufen" AutomationProperties.Name="Zurückrufen"
                        Command="{Binding DataContext.CallHistoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Direction}" Value="Outgoing">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Orange}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Missed}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Danger}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Missed}" Value="True" />
                        <Condition Binding="{Binding Direction}" Value="Incoming" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TitleText" Property="Foreground" Value="{StaticResource Danger}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Wähltaste: Ziffer + Buchstaben -->
        <DataTemplate x:Key="KeyFace">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding}" FontSize="21" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="9" FontWeight="SemiBold"
                           Foreground="{StaticResource Muted}" HorizontalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="4" />
            <RowDefinition Height="66" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Rectangle Fill="{StaticResource Orange}" />

        <!-- Kopfzeile -->
        <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0,20,0">
                <Image Source="/Assets/rbs-logo.png" Height="30" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                       ToolTip="rbs Redaktionsbüro Stutensee" />
                <Border Style="{StaticResource Badge}" Margin="16,2,0,0" Padding="9,4"
                        Visibility="{Binding IsMiniView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <TextBlock Style="{StaticResource BadgeText}" FontSize="12" Text="ringring best sipfon" />
                </Border>

                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,7" VerticalAlignment="Center"
                        Command="{Binding SettingsCommand}" AutomationProperties.Name="Einstellungen" ToolTip="Einstellungen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Text="Einstellungen" Margin="8,0,0,0"
                                   Visibility="{Binding IsMiniView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Button>
                <!-- Umschalten Mini/Voll (Strg+M) -->
                <Button x:Name="ViewToggleButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Padding="12,7" Margin="0,0,8,0"
                        VerticalAlignment="Center" Command="{Binding ToggleViewCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="ViewToggleIcon" Style="{StaticResource Icon}" />
                        <TextBlock x:Name="ViewToggleText" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <TextBlock DockPanel.Dock="Right" Text="{Binding RegistrationSummary}" FontSize="12" Foreground="{StaticResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding IsMiniView, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                <Border />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <!-- Breiten werden in der Mini-Ansicht im Code umgestellt (MainWindow.ApplyViewMode) -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AccountsColumn" Width="300" />
                <ColumnDefinition x:Name="DialColumn" Width="340" />
                <ColumnDefinition x:Name="CallsColumn" />
            </Grid.ColumnDefinitions>

            <!-- Konten -->
            <Border x:Name="AccountsPanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel Margin="18,20,18,12">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="KONTEN" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE710;" HorizontalAlignment="Right"
                                ToolTip="Konto hinzufügen" AutomationProperties.Name="Konto hinzufügen" Command="{Binding AddAccountCommand}" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasAccounts, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <Image Source="/Assets/rbs-symbol.png" Width="64" Opacity="0.85" Margin="0,24,0,14" />
                        <TextBlock Text="Noch kein SIP-Konto eingerichtet." TextAlignment="Center" FontWeight="SemiBold" />
                        <TextBlock Text="Legen Sie ein oder mehrere Konten an – alle sind gleichzeitig erreichbar."
                                   TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,14" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Konto einrichten" HorizontalAlignment="Center"
                                Command="{Binding AddAccountCommand}" />
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountCard}"
                             ItemContainerStyle="{StaticResource PlainListItem}" />
                </DockPanel>
            </Border>

            <!-- Wählfeld -->
            <Border Grid.Column="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20,24,16">
                    <!-- Mini-Ansicht: laufende Gespräche über dem Wählfeld -->
                    <StackPanel Visibility="{Binding ShowCallsInCenter, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="GESPRÄCHE" Margin="0,0,0,12" HorizontalAlignment="Left" />
                        <ListBox x:Name="MiniCallList" ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}"
                                 ItemTemplate="{StaticResource CallCard}" ItemContainerStyle="{StaticResource PlainListItem}">
                            <!-- Ohne eigenen Scrollbereich, damit das Mausrad die ganze Spalte scrollt -->
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                        </ListBox>
                    </StackPanel>

                    <TextBlock Style="{StaticResource SectionTitle}" Text="WÄHLEN" Margin="0,0,0,12" HorizontalAlignment="Left" />

                    <TextBlock Text="Anrufen über" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding DialAccount}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AccountViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="8" Height="8" Fill="{Binding State, Converter={StaticResource RegBrush}}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Address}" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Grid Margin="0,14,0,0">
                        <TextBox x:Name="NumberBox" Text="{Binding DialNumber, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="24" FontWeight="SemiBold" Padding="10,8,40,8" TextAlignment="Center"
                                 ToolTip="Rufnummer, Name oder SIP-Adresse (z. B. 0721123456 oder max@example.org)">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding DialCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Style="{StaticResource IconButton}" Content="&#xE750;" HorizontalAlignment="Right" Margin="0,0,6,0"
                                ToolTip="Letzte Ziffer löschen" AutomationProperties.Name="Löschen" Command="{Binding BackspaceCommand}" Focusable="False"
                                Visibility="{Binding DialNumber, Converter={StaticResource EmptyToCollapsed}}" />
                    </Grid>
                    <TextBlock Text="{Binding DtmfHint}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Orange}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Height="16" />

                    <UniformGrid Columns="3" Margin="-4,6,-4,0">
                        <UniformGrid.Resources>
                            <Style TargetType="Button" BasedOn="{StaticResource DialKey}">
                                <Setter Property="ContentTemplate" Value="{StaticResource KeyFace}" />
                                <Setter Property="Command" Value="{Binding KeyCommand}" />
                                <Setter Property="CommandParameter" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            </Style>
                        </UniformGrid.Resources>
                        <Button Content="1" Tag=" " />
                        <Button Content="2" Tag="ABC" />
                        <Button Content="3" Tag="DEF" />
                        <Button Content="4" Tag="GHI" />
                        <Button Content="5" Tag="JKL" />
                        <Button Content="6" Tag="MNO" />
                        <Button Content="7" Tag="PQRS" />
                        <Button Content="8" Tag="TUV" />
                        <Button Content="9" Tag="WXYZ" />
                        <Button Content="*" Tag=" " />
                        <Button Content="0" Tag="+" />
                        <Button Content="#" Tag=" " />
                    </UniformGrid>

                    <Button Style="{StaticResource PrimaryButton}" Height="50" AutomationProperties.Name="Anrufen" Margin="0,14,0,0" FontSize="15"
                            Command="{Binding DialCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE717;" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding DialButtonText}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Gespräche und Anrufliste -->
            <Grid x:Name="CallsPanel" Grid.Column="2" Margin="24,20,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" MaxHeight="420" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock Style="{StaticResource SectionTitle}" Text="GESPRÄCHE" Margin="0,0,0,12" HorizontalAlignment="Left" />

                <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                        CornerRadius="4" Padding="18" Margin="0,0,0,10"
                        Visibility="{Binding HasCalls, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/rbs-symbol.png" Width="34" Opacity="0.35" />
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Keine aktiven Gespräche" FontWeight="SemiBold" />
                            <TextBlock Text="Eingehende Anrufe aller Konten erscheinen hier." FontSize="12" Foreground="{StaticResource Muted}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Calls}" SelectedItem="{Binding SelectedCall}"
                         ItemTemplate="{StaticResource CallCard}" ItemContainerStyle="{StaticResource PlainListItem}"
                         Visibility="{Binding HasCalls, Converter={StaticResource BoolToVis}}" />

                <Grid Grid.Row="2" Margin="0,14,0,8">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="ANRUFLISTE" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" HorizontalAlignment="Right"
                            ToolTip="Anrufliste leeren" AutomationProperties.Name="Anrufliste leeren" Command="{Binding ClearHistoryCommand}" />
                </Grid>

                <Border Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="4">
                    <Grid>
                        <TextBlock Text="Noch keine Anrufe." Foreground="{StaticResource Muted}" FontSize="12" Margin="14"
                                   Visibility="{Binding History.Count, Converter={StaticResource EmptyToCollapsed}, ConverterParameter=invert}" />
                        <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" ItemTemplate="{StaticResource HistoryRow}"
                                 ItemContainerStyle="{StaticResource HistoryItem}" Padding="0,4"
                                 MouseDoubleClick="HistoryList_MouseDoubleClick" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
