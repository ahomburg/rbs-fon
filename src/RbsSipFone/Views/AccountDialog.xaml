<Window x:Class="RbsSipFone.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SIP-Konto" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <StackPanel>
        <Rectangle Height="4" Fill="{StaticResource Orange}" />
        <StackPanel Margin="28,20,28,0">
            <TextBlock x:Name="Heading" Text="Konto hinzufügen" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Die Zugangsdaten erhalten Sie von Ihrem Telefonanbieter bzw. aus der Telefonanlage."
                       Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,6" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Bezeichnung" />
            <TextBox x:Name="NameBox" ToolTip="Frei wählbar, z. B. „Büro“ oder „Redaktion“" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Benutzername / Rufnummer *" />
                    <TextBox x:Name="UserBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Domain / SIP-Server *" />
                    <TextBox x:Name="DomainBox" ToolTip="z. B. sipgate.de, tel.t-online.de oder fritz.box" />
                </StackPanel>
            </Grid>

            <TextBlock Style="{StaticResource FieldLabel}" Text="Passwort" />
            <PasswordBox x:Name="PasswordBox" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="ERWEITERT" Margin="0,22,0,0" HorizontalAlignment="Left" />
            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,6,0,0" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Anzeigename" />
                    <TextBox x:Name="DisplayNameBox" ToolTip="Name, den der Angerufene sieht (sofern der Anbieter ihn überträgt)" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Auth-Benutzername" />
                    <TextBox x:Name="AuthUserBox" ToolTip="Nur nötig, wenn er vom Benutzernamen abweicht" />
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Registrar / Outbound-Proxy" />
                    <TextBox x:Name="ProxyBox" ToolTip="Optional, z. B. proxy.example.org:5060" />
                </StackPanel>
                <Grid Grid.Row="1" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Transport" />
                        <ComboBox x:Name="TransportBox">
                            <ComboBoxItem Content="UDP" />
                            <ComboBoxItem Content="TCP" />
                            <ComboBoxItem Content="TLS" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Intervall (s)" />
                        <TextBox x:Name="ExpiryBox" ToolTip="Gültigkeit der Registrierung in Sekunden (60–3600)" />
                    </StackPanel>
                </Grid>

                <CheckBox x:Name="EnabledBox" Grid.Row="2" Grid.ColumnSpan="3" Content="Konto aktiv (beim Server anmelden)" Margin="0,16,0,0" />
            </Grid>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" MinWidth="100" />
                <Button Style="{StaticResource PrimaryButton}" Content="Speichern" IsDefault="True" MinWidth="110" Margin="10,0,0,0" Click="Save_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
