<Window x:Class="RbsSipFone.Views.AccountExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konten exportieren" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <StackPanel>
        <Rectangle Height="4" Fill="{StaticResource Orange}" />
        <StackPanel Margin="28,20,28,0">
            <TextBlock Text="Konten exportieren" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,6"
                       Text="Speichert die ausgewählten Konten in einer Datei, z. B. für einen neuen PC oder als Sicherung." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Konten" />
            <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountList" />
            </ScrollViewer>

            <CheckBox x:Name="PasswordsBox" Content="Passwörter mitexportieren (im Klartext)" IsChecked="True" Margin="0,18,0,0" />
            <TextBlock x:Name="PlainPasswordHint" Style="{StaticResource Hint}" Foreground="{StaticResource Danger}"
                       Text="Achtung: Die Datei ist nicht verschlüsselt. Wer sie lesen kann, kann Ihre Konten benutzen. Bewahren Sie sie sicher auf und löschen Sie sie nach dem Import." />
            <TextBlock x:Name="NoPasswordHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                       Text="Die Datei enthält dann keine Passwörter. Neue Konten sind nach dem Import deaktiviert, bis das Passwort eingetragen ist." />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" MinWidth="100" />
                <Button Style="{StaticResource PrimaryButton}" Content="Exportieren …" IsDefault="True" MinWidth="110" Margin="10,0,0,0" Click="Export_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
