<Window x:Class="RbsSipFone.Views.AccountImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Konten importieren" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <StackPanel>
        <Rectangle Height="4" Fill="{StaticResource Orange}" />
        <StackPanel Margin="28,20,28,0">
            <TextBlock Text="Konten importieren" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="FileText" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,6" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Konten in der Datei" />
            <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountList" />
            </ScrollViewer>
            <TextBlock x:Name="NoPasswordHint" Style="{StaticResource Hint}" Margin="0,8,0,0" Visibility="Collapsed"
                       Text="Nicht alle Konten in der Datei haben ein Passwort. Neue Konten ohne Passwort werden deaktiviert importiert: Passwort eintragen und Konto einschalten." />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" MinWidth="100" />
                <Button Style="{StaticResource PrimaryButton}" Content="Importieren" IsDefault="True" MinWidth="110" Margin="10,0,0,0" Click="Import_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
