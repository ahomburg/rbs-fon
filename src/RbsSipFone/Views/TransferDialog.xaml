<Window x:Class="RbsSipFone.Views.TransferDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Weiterleiten" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Surface}" FontFamily="{StaticResource AppFont}" Foreground="{StaticResource Ink}"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True">
    <StackPanel>
        <Rectangle Height="4" Fill="{StaticResource Orange}" />
        <StackPanel Margin="28,20,28,0">
            <TextBlock Text="Gespräch weiterleiten" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="CallInfo" Style="{StaticResource Hint}" FontSize="12" Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="An Rufnummer oder SIP-Adresse" Margin="0,16,0,4" />
            <TextBox x:Name="TargetBox" FontSize="16" />
            <TextBlock Style="{StaticResource Hint}" Text="Blindes Weiterleiten: Das Gespräch wird sofort übergeben." />

            <StackPanel x:Name="OtherPanel" Visibility="Collapsed">
                <TextBlock Style="{StaticResource FieldLabel}" Text="… oder mit laufendem Gespräch verbinden" Margin="0,18,0,4" />
                <ComboBox x:Name="OtherBox" DisplayMemberPath="Title" />
                <TextBlock Style="{StaticResource Hint}" Text="Vermitteln: Beide Gesprächspartner werden miteinander verbunden, Sie scheiden aus." />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" FontWeight="SemiBold" FontSize="12"
                       TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
        </StackPanel>

        <Border Background="{StaticResource Page}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="28,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" IsCancel="True" MinWidth="100" />
                <Button Style="{StaticResource PrimaryButton}" Content="Weiterleiten" IsDefault="True" MinWidth="120" Margin="10,0,0,0" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
