<Application x:Class="RbsSipFone.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RbsSipFone.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <views:BoolToVisibilityConverter x:Key="BoolToVis" />
            <views:EmptyToCollapsedConverter x:Key="EmptyToCollapsed" />
            <views:RegistrationBrushConverter x:Key="RegBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
